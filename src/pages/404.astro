---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Not found" description="That page doesn't exist." noindex>
  <div class="prose-wrap notfound">
    <p class="eyebrow">404</p>
    <h1>Nothing here.</h1>
    <p class="muted">
      This page doesn't exist. It may have moved, or never did. Try the
      <a href="/writing">writing archive</a> or head <a href="/">home</a>.
    </p>
  </div>
</BaseLayout>

<style>
  .notfound {
    padding: clamp(4rem, 15vh, 8rem) 24px;
    text-align: center;
  }
  .notfound h1 {
    font-size: clamp(2.4rem, 8vw, 4rem);
    margin: 0.5rem 0 1rem;
  }
  .notfound .muted {
    max-width: 42ch;
    margin: 0 auto;
  }
</style>
