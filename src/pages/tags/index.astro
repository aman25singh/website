---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getTags } from "../../lib/content";

const tags = await getTags();
---

<BaseLayout title="Tags" description="Browse writing by topic.">
  <div class="prose-wrap page">
    <header class="page-head">
      <p class="eyebrow">Index</p>
      <h1>Tags</h1>
      <p class="muted">Browse writing by topic.</p>
    </header>

    {
      tags.length === 0 ? (
        <p class="muted">No tags yet.</p>
      ) : (
        <ul class="cloud">
          {tags.map((t) => (
            <li>
              <a href={`/tags/${t.tag}`}>
                #{t.tag} <span>{t.count}</span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</BaseLayout>

<style>
  .page {
    padding-top: 2.5rem;
  }
  .page-head h1 {
    font-size: clamp(2rem, 5vw, 2.8rem);
    margin: 0.4rem 0 0.6rem;
  }
  .cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    list-style: none;
    padding: 0;
    margin: 2rem 0 0;
  }
  .cloud a {
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--muted);
    text-decoration: none;
    padding: 5px 12px;
    border: 1px solid var(--border);
    border-radius: 999px;
    transition:
      color 0.18s ease,
      border-color 0.18s ease;
  }
  .cloud a:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
  .cloud span {
    color: var(--faint);
  }
</style>
