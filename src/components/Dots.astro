---
// Animated particle background, ported from the original site's dots.js.
// Opt-in per page (used on the homepage hero only) to keep reading pages calm
// and JS-free. Reads CSS custom properties so it tracks light/dark automatically
// and honours prefers-reduced-motion (renders nothing).
---

<canvas id="dots" aria-hidden="true"></canvas>

<style>
  #dots {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    pointer-events: none;
    z-index: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    #dots {
      display: none;
    }
  }
</style>

<script>
  (function () {
    const canvas = document.getElementById("dots") as HTMLCanvasElement | null;
    if (!canvas) return;
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    const ctx = canvas.getContext("2d");
    if (!ctx) return;
    const dpr = Math.min(window.devicePixelRatio || 1, 2);

    function readVars() {
      const s = getComputedStyle(document.documentElement);
      return {
        BG: s.getPropertyValue("--bg-fallback").trim() || "#f6f1e9",
        DOT: s.getPropertyValue("--dots").trim() || "rgba(42,39,37,0.16)",
        LINK: s.getPropertyValue("--dots-link").trim() || "rgba(109,91,181,0.32)",
        GLOW: s.getPropertyValue("--dots-glow").trim() || "rgba(109,91,181,0.55)",
      };
    }
    let { BG, DOT, LINK, GLOW } = readVars();

    const BASE_SPEED = 0.09;
    const LINK_DIST = 140;
    const MOUSE_RADIUS = 90;
    const MOUSE_PAD = 2;
    const GLOW_RADIUS = 200;

    type Node = { x: number; y: number; a: number };
    let nodes: Node[] = [];
    let last = performance.now();
    let COUNT = 120,
      W = 0,
      H = 0;
    const mouse = { x: -9999, y: -9999 };

    function resize() {
      W = window.innerWidth;
      H = window.innerHeight;
      canvas!.width = Math.floor(W * dpr);
      canvas!.height = Math.floor(H * dpr);
      canvas!.style.width = W + "px";
      canvas!.style.height = H + "px";
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
      COUNT = Math.max(60, Math.min(180, Math.floor((W * H) / 9000)));
      const need = COUNT - nodes.length;
      if (need > 0) {
        for (let i = 0; i < need; i++)
          nodes.push({
            x: Math.random() * W,
            y: Math.random() * H,
            a: Math.random() * Math.PI * 2,
          });
      } else if (need < 0) {
        nodes.length = COUNT;
      }
    }

    addEventListener("resize", resize);
    addEventListener("mousemove", (e) => ((mouse.x = e.clientX), (mouse.y = e.clientY)), {
      passive: true,
    });
    addEventListener("mouseleave", () => (mouse.x = mouse.y = -9999), { passive: true });
    // Re-read colours when the theme toggles.
    new MutationObserver(() => ({ BG, DOT, LINK, GLOW } = readVars())).observe(
      document.documentElement,
      { attributes: true, attributeFilter: ["data-theme"] },
    );

    resize();

    function excludeMouse(n: Node) {
      const dx = n.x - mouse.x,
        dy = n.y - mouse.y;
      const d = Math.hypot(dx, dy);
      if (d < MOUSE_RADIUS && d > 0.0001) {
        const ang = Math.atan2(dy, dx);
        const t = MOUSE_RADIUS + MOUSE_PAD;
        n.x = mouse.x + Math.cos(ang) * t;
        n.y = mouse.y + Math.sin(ang) * t;
        n.a = ang;
      }
    }
    const mdist = (n: Node) => Math.hypot(n.x - mouse.x, n.y - mouse.y);

    function frame(now: number) {
      const dt = Math.min(50, now - last);
      last = now;
      ctx!.fillStyle = BG;
      ctx!.fillRect(0, 0, W, H);

      for (const n of nodes) {
        n.x += Math.cos(n.a) * BASE_SPEED * dt;
        n.y += Math.sin(n.a) * BASE_SPEED * dt;
        if (n.x < 0) n.x += W;
        if (n.x > W) n.x -= W;
        if (n.y < 0) n.y += H;
        if (n.y > H) n.y -= H;
        excludeMouse(n);
      }

      for (const n of nodes) {
        const md = mdist(n);
        const t = md < GLOW_RADIUS ? 1 - md / GLOW_RADIUS : 0;
        if (t > 0) {
          ctx!.fillStyle = GLOW;
          ctx!.globalAlpha = 0.25 + t * 0.75;
          ctx!.beginPath();
          ctx!.arc(n.x, n.y, 2 + t * 1.5, 0, Math.PI * 2);
          ctx!.fill();
          ctx!.globalAlpha = 1;
        } else {
          ctx!.fillStyle = DOT;
          ctx!.beginPath();
          ctx!.arc(n.x, n.y, 2, 0, Math.PI * 2);
          ctx!.fill();
        }
      }

      ctx!.lineWidth = 1;
      for (let i = 0; i < nodes.length; i++) {
        for (let j = i + 1; j < i + 16 && j < nodes.length; j++) {
          const a = nodes[i],
            b = nodes[j];
          const d = Math.hypot(a.x - b.x, a.y - b.y);
          if (d < LINK_DIST) {
            const distAlpha = 1 - d / LINK_DIST;
            const near = mdist(a) < GLOW_RADIUS && mdist(b) < GLOW_RADIUS;
            ctx!.strokeStyle = near ? GLOW : LINK;
            ctx!.globalAlpha = distAlpha;
            ctx!.beginPath();
            ctx!.moveTo(a.x, a.y);
            ctx!.lineTo(b.x, b.y);
            ctx!.stroke();
          }
        }
      }
      ctx!.globalAlpha = 1;

      if (!document.hidden) requestAnimationFrame(frame);
      else setTimeout(() => requestAnimationFrame(frame), 200);
    }

    requestAnimationFrame(frame);
    document.addEventListener("visibilitychange", () => {
      if (!document.hidden) last = performance.now();
    });
  })();
</script>
