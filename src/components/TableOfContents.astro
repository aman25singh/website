---
import type { MarkdownHeading } from "astro";

interface Props {
  headings: MarkdownHeading[];
}

// Only surface h2/h3, since deeper nesting makes a noisy TOC.
const toc = Astro.props.headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{
  toc.length >= 3 && (
    <nav class="toc" aria-label="Table of contents">
      <p class="toc-title">On this page</p>
      <ul>
        {toc.map((h) => (
          <li class:list={[`depth-${h.depth}`]}>
            <a href={`#${h.slug}`}>{h.text}</a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

<style>
  .toc {
    font-size: 13.5px;
  }
  .toc-title {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--faint);
    margin: 0 0 0.6rem;
  }
  .toc ul {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 1px solid var(--border);
  }
  .toc li {
    margin: 0;
  }
  .toc li.depth-3 {
    padding-left: 0.9rem;
  }
  .toc a {
    display: block;
    padding: 0.25rem 0 0.25rem 0.9rem;
    margin-left: -1px;
    color: var(--muted);
    text-decoration: none;
    border-left: 2px solid transparent;
    line-height: 1.4;
  }
  .toc a:hover {
    color: var(--accent);
    border-left-color: var(--accent);
  }
</style>
