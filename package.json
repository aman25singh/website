{
  "name": "thecognitivekombucha",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Personal website and engineering notebook for thecognitivekombucha.com",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "npm run content:check && astro build && npm run output:check",
    "preview": "astro preview",
    "check": "astro check",
    "format": "prettier --write \"**/*.{astro,ts,js,mjs,md,mdx,css,json}\"",
    "format:check": "prettier --check \"**/*.{astro,ts,js,mjs,md,mdx,css,json}\"",
    "blog:new": "node scripts/new-post.mjs",
    "verify": "npm test && astro check && npm run build",
    "content:check": "node scripts/content-check.mjs",
    "output:check": "node scripts/output-check.mjs",
    "test": "node --test scripts/*.test.mjs",
    "assets:generate": "node scripts/generate-assets.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.5",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "parse5": "^8.0.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "sharp": "^0.35.5",
    "typescript": "^5.7.0",
    "yaml": "^2.8.1"
  }
}
